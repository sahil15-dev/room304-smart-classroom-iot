# Local-only file. Copy to .env; NEVER commit the real .env or keys.
ROOM304_PORT=COM3
ROOM304_BAUD=9600
THINGSPEAK_WRITE_KEY=
THINGSPEAK_CHANNEL_ID=
THINGSPEAK_READ_KEY=
# Local reads the laptop CSV; cloud reads private ThingSpeak history.
DASHBOARD_DATA_SOURCE=local
# Optional password for hosted read-only dashboard. Leave unset locally.
DASHBOARD_ACCESS_PASSWORD=
