# Local-only file. Copy to .env; NEVER commit the real .env or keys.
ROOM304_PORT=COM3
ROOM304_BAUD=9600
THINGSPEAK_WRITE_KEY=
THINGSPEAK_CHANNEL_ID=
THINGSPEAK_READ_KEY=
# Local reads the laptop CSV; cloud reads private ThingSpeak history.
DASHBOARD_DATA_SOURCE=local
# Local dashboard: no login needed unless you set credentials here.
# On Render: REQUIRE_AUTH=true and set both credentials privately in Render.
DASHBOARD_REQUIRE_AUTH=false
DASHBOARD_ACCESS_USERNAME=
DASHBOARD_ACCESS_PASSWORD=
